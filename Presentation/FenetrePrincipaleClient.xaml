<Window x:Class="AlbionMarketSync.Presentation.FenetrePrincipaleClient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Albion Market Sync v2.0 — Assistant de Craft &amp; Synchronisation Google Sheets"
        Width="1280" Height="820"
        MinWidth="1050" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== BANDEAU SUPÉRIEUR : CONNEXION GOOGLE & STATUT NPCAP ==================== -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="16,12" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Titre & Voyant Npcap -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="⚔️ ALBION MARKET SYNC" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse x:Name="PastilleStatutReseau" Width="11" Height="11" Fill="#EAB308" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock x:Name="TexteStatutReseau" Text="Écoute réseau Npcap en cours..." FontSize="12.5" Foreground="#CBD5E1" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Connexion Google Sheet (URL/ID + Bouton Compte Google) -->
                <Border Grid.Column="2" Background="#0F172A" CornerRadius="8" Padding="12,8" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="📄 Google Sheet (URL ou ID) :" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" Margin="0,0,8,0" />
                            <TextBox x:Name="ChampUrlOuIdSheet" Grid.Column="1" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" Padding="8,4" FontSize="12.5" VerticalContentAlignment="Center" />
                            <Button x:Name="BoutonAppliquerSheet" Grid.Column="2" Content="Appliquer Sheet" Margin="8,0,0,0" Padding="10,4" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Click="SurClicAppliquerSheet" />
                            <Button x:Name="BoutonConnecterGoogle" Grid.Column="3" Content="🤖 Copier l'e-mail du Bot Google" Margin="8,0,0,0" Padding="12,4" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="SurClicConnecterCompteGoogle" />
                        </Grid>

                        <TextBlock x:Name="TexteModeAuthentificationGoogle" Grid.Row="2" Text="🟢 Synchronisation prête" FontSize="11.5" Foreground="#38BDF8" />
                    </Grid>
                </Border>

                <!-- Compteurs & Stratégie de Prix -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                        <TextBlock Text="Mode de prix :" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="ListeStrategiePrix" Width="175" SelectedIndex="0" SelectionChanged="SurChangementStrategiePrix">
                            <ComboBoxItem Content="Prix Vente Minimum" />
                            <ComboBoxItem Content="Moyenne Pondérée (10 u.)" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="TexteCompteursCapture" Text="Paquets UDP : 0  |  Pages HV : 0  |  Cellules sync. : 0" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== CORPS PRINCIPAL (PARAMÈTRES DE CRAFT + ASSISTANT REQUÊTES) ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- COLONNE GAUCHE : CONFIGURATION DU CRAFT (CAPES, TIER MAX, ENCHANTEMENT MAX) -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="16" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🛠️ PARAMÈTRES DE CRAFT (CAPES)" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" />

                    <!-- Sélecteurs Niveau (Tier) Max et Enchantement Max -->
                    <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="12" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="1. Niveau (Tier) Max à crafter :" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4" />
                            <ComboBox x:Name="ListeTierMax" SelectedIndex="2" Padding="8,5" FontSize="13" SelectionChanged="SurModificationFiltresCraft">
                                <ComboBoxItem Content="T4 — Adepte (uniquement T4)" Tag="4" />
                                <ComboBoxItem Content="T5 — Expert (de T4 à T5)" Tag="5" />
                                <ComboBoxItem Content="T6 — Maître (de T4 à T6)" Tag="6" />
                                <ComboBoxItem Content="T7 — Grand Maître (de T4 à T7)" Tag="7" />
                                <ComboBoxItem Content="T8 — Ancien (de T4 à T8)" Tag="8" />
                            </ComboBox>

                            <TextBlock Text="2. Enchantement Max à crafter :" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,12,0,4" />
                            <ComboBox x:Name="ListeEnchantementMax" SelectedIndex="2" Padding="8,5" FontSize="13" SelectionChanged="SurModificationFiltresCraft">
                                <ComboBoxItem Content=".0 — Sans enchantement (.0)" Tag="0" />
                                <ComboBoxItem Content=".1 — Inhabituel (de .0 à .1)" Tag="1" />
                                <ComboBoxItem Content=".2 — Rare (de .0 à .2)" Tag="2" />
                                <ComboBoxItem Content=".3 — Exceptionnel (de .0 à .3)" Tag="3" />
                                <ComboBoxItem Content=".4 — Remarquable (de .0 à .4)" Tag="4" />
                            </ComboBox>

                            <CheckBox x:Name="CaseExigerActualisationSession"
                                      Content="Actualiser même les cases déjà remplies"
                                      Foreground="#CBD5E1"
                                      FontSize="12"
                                      Margin="0,12,0,0"
                                      Checked="SurModificationFiltresCraft"
                                      Unchecked="SurModificationFiltresCraft" />
                        </StackPanel>
                    </Border>

                    <!-- En-tête sélection des Capes -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="3. Capes à crafter :" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Tout" Padding="8,2" Margin="0,0,4,0" FontSize="11.5" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Click="SurClicToutCocherCapes" />
                        <Button Grid.Column="2" Content="Aucun" Padding="8,2" FontSize="11.5" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Click="SurClicToutDecocherCapes" />
                    </Grid>

                    <!-- Liste des 14 Capes avec cases à cocher -->
                    <Border Grid.Row="6" Background="#0F172A" CornerRadius="8" Padding="8" BorderBrush="#334155" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ListeCasesCapes">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,5" Margin="0,1" CornerRadius="4" Background="#162032">
                                            <CheckBox IsChecked="{Binding EstSelectionnee, Mode=TwoWay}"
                                                      Checked="SurModificationCaseCape"
                                                      Unchecked="SurModificationCaseCape"
                                                      VerticalContentAlignment="Center">
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding NomAffichage}" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding DetailIngredients}" Foreground="#94A3B8" FontSize="11" />
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Button Grid.Row="8" Content="🔄 Revérifier la feuille 'Indice prix'" Padding="10,8" Background="#0284C7" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="SurClicActualiserFeuilleIndicePrix" />
                </Grid>
            </Border>

            <!-- COLONNE DROITE : CARTE "PROCHAINE REQUÊTE À FAIRE" + TABLEAU DE SUIVI + JOURNAL -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>

                <!-- CARTE PRINCIPALE : PROCHAINE REQUÊTE À FAIRE DANS L'HÔTEL DES VENTES -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="20,16" BorderBrush="#F59E0B" BorderThickness="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- En-tête + Barre de progression -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="🎯 PROCHAINE REQUÊTE À FAIRE À L'HÔTEL DES VENTES" FontSize="15.5" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" />
                                <TextBlock x:Name="TexteCategorieProchaineRequete" Text="  —  Ressource" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="TexteProgressionEtapes" Grid.Column="1" Text="0 / 0 ingrédients validés" FontSize="13.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Les 3 grands blocs d'instructions : OBJET | TIER | ENCHANTEMENT -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 1. Nom de l'objet à chercher -->
                            <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Padding="14,10" BorderBrush="#475569" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="1. RECHERCHER L'OBJET DANS L'HV :" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TexteNomObjetProchaineRequete" Text="Cuir" FontSize="22" FontWeight="Bold" Foreground="#22C55E" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!-- 2. Filtre Tier -->
                            <Border Grid.Column="2" Background="#0F172A" CornerRadius="8" Padding="14,10" BorderBrush="#475569" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="2. FILTRE TIER (PALIER) :" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TexteTierProchaineRequete" Text="T4" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 3. Filtre Enchantement -->
                            <Border Grid.Column="4" Background="#0F172A" CornerRadius="8" Padding="14,10" BorderBrush="#475569" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="3. FILTRE ENCHANTEMENT :" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TexteEnchantementProchaineRequete" Text=".0" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Boutons d'action rapide -->
                            <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                <Button Content="📋 Copier le nom (Ctrl+V)" Padding="14,8" Margin="0,0,0,6" Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="SurClicCopierNomRecherche" />
                                <Button Content="⏭️ Passer cette étape" Padding="14,6" Background="#475569" Foreground="White" BorderThickness="0" Cursor="Hand" Click="SurClicPasserEtape" />
                            </StackPanel>
                        </Grid>

                        <!-- Barre de progression & détail cellule cible -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="BarreProgressionRequetes" Grid.Column="0" Height="10" Minimum="0" Maximum="100" Value="0" Background="#0F172A" Foreground="#22C55E" BorderThickness="0" />
                            <TextBlock x:Name="TexteCelluleCibleProchaineRequete" Grid.Column="2" Text="Cellule visée : 'Indice prix'!B8" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- TABLEAU DE TOUTES LES REQUÊTES DU PLAN DE CRAFT -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="10" Padding="14" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📋 PLAN DE RECHERCHE COMPLET BASÉ SUR LA FEUILLE 'INDICE PRIX'" FontSize="13.5" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Réinitialiser la session" Padding="10,4" FontSize="11.5" Background="#334155" Foreground="#E2E8F0" BorderThickness="0" Cursor="Hand" Click="SurClicReinitialiserSession" />
                        </Grid>

                        <DataGrid x:Name="TableauPlanRequetes"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="#0F172A"
                                  RowBackground="#0F172A"
                                  AlternatingRowBackground="#162032"
                                  Foreground="#F8FAFC"
                                  BorderBrush="#334155"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#1E293B"
                                  HeadersVisibility="Column"
                                  RowHeight="30"
                                  FontSize="12.5">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B" />
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="10,6" />
                                    <Setter Property="BorderBrush" Value="#334155" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding NumeroOrdre}" Width="45" />
                                <DataGridTextColumn Header="Catégorie d'ingrédient" Binding="{Binding CategorieIngredient}" Width="210" />
                                <DataGridTextColumn Header="Objet à chercher en jeu" Binding="{Binding NomObjetAChercherEnJeu}" Width="190" />
                                <DataGridTextColumn Header="Tier" Binding="{Binding FiltrePalierTier}" Width="85" />
                                <DataGridTextColumn Header="Enchantement" Binding="{Binding FiltreEnchantement}" Width="110" />
                                <DataGridTextColumn Header="Cellule 'Indice prix'" Binding="{Binding CoordonneeCelluleIndicePrix}" Width="140" />
                                <DataGridTextColumn Header="Statut dans 'Indice prix'" Binding="{Binding StatutTextuel}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- JOURNAL D'ACTIVITÉ EN TEMPS RÉEL -->
                <Border Grid.Row="4" Background="#1E293B" CornerRadius="10" Padding="12" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📡 JOURNAL DE CAPTURE &amp; ENVOIS GOOGLE SHEETS EN DIRECT" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" />
                        <ListBox x:Name="ListeJournalTempsReel" Grid.Row="2" Background="#0F172A" Foreground="#CBD5E1" BorderBrush="#334155" FontFamily="Consolas" FontSize="11.5" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
